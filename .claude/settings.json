{
  "permissions": {
    "deny": [
      "WebFetch", "WebSearch", "Read(./.env)", "Read(./.env.*)",
      "Read(//proc/**)", "Read(//etc/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-writes.mjs\"" }]
      }
    ]
  }
}
